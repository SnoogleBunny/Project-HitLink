{
  "name": "admin-web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:migration:integration": "node -e \"if (!process.env.TEST_DATABASE_URL) { console.error('TEST_DATABASE_URL is required for migration integration tests.'); process.exit(1); }\" && vitest run lib/workspace-migration.integration.test.ts lib/workspace-migration-operations.integration.test.ts"
  },
  "dependencies": {
    "@flowstate/auth": "workspace:*",
    "@flowstate/db": "workspace:*",
    "@flowstate/ui": "workspace:*",
    "csv-parse": "^6.2.1",
    "next": "16.2.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "^22.0.0"
  },
  "devDependencies": {
    "@flowstate/eslint-config": "workspace:*",
    "@flowstate/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  }
}
