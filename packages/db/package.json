{
  "name": "@flowstate/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "pnpm run test:workspace-readiness && pnpm run test:demo-safety && pnpm run test:migration-schema && pnpm run db:validate",
    "test:workspace-readiness": "vitest run src/workspace-readiness.test.ts",
    "test:demo-safety": "node --test prisma/demo-database-safety.test.mjs",
    "test:migration-schema": "node --test prisma/migration-operations-schema.test.mjs",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy --schema prisma/schema.prisma",
    "db:reset:demo": "dotenv -e ../../.env -- node prisma/reset-demo.mjs && corepack pnpm run db:seed",
    "db:seed": "dotenv -e ../../.env -- node prisma/seed-demo.mjs",
    "db:verify:demo-seed": "dotenv -e ../../.env -- node prisma/seed-demo.mjs && dotenv -e ../../.env -- node prisma/verify-demo-seed.mjs && dotenv -e ../../.env -- node prisma/seed-demo.mjs && dotenv -e ../../.env -- node prisma/verify-demo-seed.mjs",
    "db:studio": "dotenv -e ../../.env -- prisma studio --schema prisma/schema.prisma",
    "db:validate": "dotenv -v DATABASE_URL=postgresql://localhost/flowstate_dev?schema=public -- prisma validate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0"
  },
  "devDependencies": {
    "@flowstate/eslint-config": "workspace:*",
    "@flowstate/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "bcryptjs": "^3.0.3",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.39.1",
    "prisma": "^6.18.0",
    "typescript": "5.9.2"
  }
}
