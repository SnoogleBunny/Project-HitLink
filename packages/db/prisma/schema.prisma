model MemberOperationalRevision {
  id                    String                      @id @default(cuid())
  workspaceId           String
  memberId              String
  recordKey             String
  recordKind            String
  version               Int
  previousVersion       Int?                        @default(dbgenerated())
  action                String
  visibility            String
  noteBody              String?
  tagLabel              String?
  tagPurpose            String?
  actorUserId           String
  actorWorkspaceUserId  String
  actorNameSnapshot     String
  actorRoleSnapshot     String
  sourceClassTemplateId String?
  sourceScheduledDate   DateTime?                   @db.Date
  reason                String?
  operationId           String
  inputHash             String
  createdAt             DateTime                    @default(now())
  workspace             Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "member_operations_workspace_fk")
  member                Member                      @relation(fields: [workspaceId, memberId], references: [workspaceId, id], onDelete: Cascade, map: "member_operations_member_fk")
  previousRevision      MemberOperationalRevision?  @relation("MemberOperationalChain", fields: [workspaceId, memberId, recordKey, previousVersion], references: [workspaceId, memberId, recordKey, version], onDelete: NoAction, onUpdate: NoAction, map: "member_ops_predecessor_fk")
  successorRevisions    MemberOperationalRevision[] @relation("MemberOperationalChain")

  @@unique([workspaceId, operationId], map: "member_ops_workspace_operation_key")
  @@unique([workspaceId, memberId, recordKey, version], map: "member_ops_workspace_member_record_version_key")
  @@index([workspaceId, memberId, recordKind, recordKey, version], map: "member_ops_current_record_idx")
  @@index([workspaceId, memberId, createdAt, id], map: "member_ops_member_history_idx")
  @@index([workspaceId, memberId, recordKey, previousVersion], map: "member_ops_predecessor_idx")
  @@map("member_operational_revisions")
}

model FormRequirementRevision {
  id                   String                @id @default(cuid())
  workspaceId          String
  formDocumentId       String
  formVersionId        String
  version              Int
  terms                Json
  fileSha256           String
  effectiveAt          DateTime
  publishedAt          DateTime
  actorUserId          String
  reason               String
  previousRevisionHash String?
  revisionHash         String
  previewHash          String
  legacyBaseline       Json?
  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  formDocument         FormDocument          @relation(fields: [workspaceId, formDocumentId], references: [workspaceId, id], onDelete: Restrict, map: "form_revision_document_scope_fk")
  formVersion          FormVersion           @relation(fields: [workspaceId, formDocumentId, formVersionId], references: [workspaceId, formDocumentId, id], onDelete: Restrict, map: "form_revision_version_scope_fk")
  actor                User                  @relation("FormRequirementPublisher", fields: [actorUserId], references: [id], onDelete: Restrict)
  signatureRequests    SignatureRequest[]
  signedDocuments      SignedDocument[]
  recoveries           BookingFormRecovery[]

  @@unique([formDocumentId, version])
  @@unique([workspaceId, id], map: "form_revision_workspace_id_key")
  @@unique([workspaceId, formVersionId, id], map: "form_revision_workspace_version_id_key")
  @@index([workspaceId, formDocumentId, effectiveAt, version])
  @@map("form_requirement_revisions")
}

model BookingFormRecovery {
  id                        String                  @id @default(cuid())
  workspaceId               String
  bookingId                 String
  bookingFundingRevision    Int
  requirementRevisionId     String
  acceptedSnapshotHash      String?
  evidence                  Json
  evidenceHash              String
  openedAt                  DateTime
  openedByUserId            String
  assignedToWorkspaceUserId String
  state                     String                  @default("OPEN")
  version                   Int                     @default(1)
  replacementBookingId      String?
  financialReviewCaseId     String?
  resolvedAt                DateTime?
  workspace                 Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  booking                   ClassBooking            @relation("FormRecoveryOriginalBooking", fields: [workspaceId, bookingId], references: [workspaceId, id], onDelete: Restrict, map: "form_recovery_original_scope_fk")
  requirementRevision       FormRequirementRevision @relation(fields: [workspaceId, requirementRevisionId], references: [workspaceId, id], onDelete: Restrict, map: "form_recovery_revision_scope_fk")
  openedBy                  User                    @relation("FormRecoveryOpener", fields: [openedByUserId], references: [id], onDelete: Restrict)
  assignedTo                WorkspaceUser           @relation("FormRecoveryReviewer", fields: [workspaceId, assignedToWorkspaceUserId], references: [workspaceId, id], onDelete: Restrict, map: "form_recovery_reviewer_scope_fk")
  replacementBooking        ClassBooking?           @relation("FormRecoveryReplacementBooking", fields: [workspaceId, replacementBookingId], references: [workspaceId, id], onDelete: Restrict, map: "form_recovery_replacement_scope_fk")
  financialReviewCase       FinancialReviewCase?    @relation(fields: [workspaceId, financialReviewCaseId], references: [workspaceId, id], onDelete: Restrict, map: "form_recovery_financial_case_scope_fk")

  @@unique([bookingId, bookingFundingRevision, requirementRevisionId], map: "booking_form_recovery_commitment_revision_key")
  @@index([workspaceId, state, openedAt])
  @@index([workspaceId, assignedToWorkspaceUserId, state])
  @@map("booking_form_recoveries")
}

model CoachingBookingPolicy {
  id             String             @id @default(cuid())
  workspaceId    String             @unique
  version        Int
  policy         Json
  policyHash     String
  currentEventId String             @unique
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  currentEvent   WorkspaceDataEvent @relation("CoachingPolicyCurrentReceipt", fields: [workspaceId, currentEventId], references: [workspaceId, id], onDelete: Cascade)
  updatedAt      DateTime           @updatedAt

  @@unique([workspaceId, currentEventId], map: "coaching_booking_policy_workspace_receipt_key")
  @@map("coaching_booking_policies")
}
