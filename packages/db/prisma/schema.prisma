  importJob   ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, importJobId, generatedAt])
  @@map("reconciliation_reports")
}

model MigrationImportedRecord {
  id               String           @id @default(cuid())
  workspaceId      String
  importJobId      String?
  stagingRecordId  String?
  recordKind       ImportRecordKind
  externalId       String
  importedModel    String
  importedRecordId String
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([workspaceId, recordKind, externalId], map: "migration_imported_records_workspace_kind_external_key")
  @@index([workspaceId, importJobId])
  @@index([workspaceId, importedModel, importedRecordId], map: "migration_imported_records_workspace_model_record_idx")
  @@map("migration_imported_records")
}

model ProgressModuleSetting {
  id          String               @id @default(cuid())
  workspaceId String               @unique
  status      ProgressModuleStatus @default(DISABLED)
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("progress_module_settings")
}

model BeltDefinition {
  id               String                @id @default(cuid())
  workspaceId      String
  name             String
  rankOrder        Int
  isActive         Boolean               @default(true)
  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  progressStates   MemberProgressState[]
  promotionRecords PromotionRecord[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([workspaceId, name])
  @@unique([workspaceId, rankOrder])
  @@index([workspaceId, isActive, rankOrder])
  @@map("belt_definitions")
}

model MemberProgressState {
  id                      String          @id @default(cuid())
  workspaceId             String
  memberId                String          @unique
  currentBeltDefinitionId String?
  currentStripeCount      Int             @default(0)
  lastPromotedAt          DateTime?
  workspace               Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member                  Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  currentBeltDefinition   BeltDefinition? @relation(fields: [currentBeltDefinitionId], references: [id], onDelete: SetNull)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([workspaceId, currentBeltDefinitionId])
  @@map("member_progress_states")
}

model PromotionRecord {
  id               String          @id @default(cuid())
  workspaceId      String
  memberId         String
  beltDefinitionId String?
  stripeCount      Int             @default(0)
  promotedAt       DateTime
  notes            String?
  source           BillingSource   @default(CURRENT)
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member           Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  beltDefinition   BeltDefinition? @relation(fields: [beltDefinitionId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([workspaceId, memberId, promotedAt])
  @@map("promotion_records")
}

model ConversationThread {
  id           String                    @id @default(cuid())
  workspaceId  String
  subject      String?
  status       ConversationThreadStatus  @default(OPEN)
  workspace    Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([workspaceId, status, updatedAt])
  @@map("conversation_threads")
}

model ConversationParticipant {
  id                   String                      @id @default(cuid())
  workspaceId          String
  conversationThreadId String
  kind                 ConversationParticipantKind
  workspaceUserId      String?
  memberId             String?
  guardianId           String?
  lastReadAt           DateTime?
  workspace            Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversationThread   ConversationThread          @relation(fields: [conversationThreadId], references: [id], onDelete: Cascade)
  member               Member?                     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  guardian             Guardian?                   @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@index([workspaceId, conversationThreadId])
  @@index([workspaceId, memberId])
  @@index([workspaceId, guardianId])
  @@map("conversation_participants")
}

model Message {
  id                    String             @id @default(cuid())
  workspaceId           String
  conversationThreadId  String
  senderKind            MessageSenderKind
  senderWorkspaceUserId String?
  senderMemberId        String?
  senderGuardianId      String?
  body                  String
  status                MessageStatus      @default(SENT)
  sentAt                DateTime           @default(now())
  workspace             Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversationThread    ConversationThread @relation(fields: [conversationThreadId], references: [id], onDelete: Cascade)
  senderMember          Member?            @relation(fields: [senderMemberId], references: [id], onDelete: SetNull)
  senderGuardian        Guardian?          @relation(fields: [senderGuardianId], references: [id], onDelete: SetNull)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([workspaceId, conversationThreadId, sentAt])
  @@index([workspaceId, senderMemberId])
  @@map("messages")
}

model Announcement {
  id                       String             @id @default(cuid())
  workspaceId              String
  createdByWorkspaceUserId String?
  title                    String
  body                     String
  status                   AnnouncementStatus @default(DRAFT)
  sendEmail                Boolean            @default(false)
  queuedAt                 DateTime?
  sentAt                   DateTime?
  workspace                Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  notificationJobs         NotificationJob[]
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([workspaceId, status, createdAt])
  @@map("announcements")
}

model NotificationJob {
  id                String                @id @default(cuid())
  workspaceId       String
  announcementId    String?
  templateKind      EmailTemplateKind
  recipientEmail    String                @db.Citext
  recipientName     String?
  subject           String
  body              String
  status            NotificationJobStatus @default(PENDING)
  attempts          Int                   @default(0)
  nextAttemptAt     DateTime?
  sentAt            DateTime?
  lastError         String?
  providerMessageId String?
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  announcement      Announcement?         @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([workspaceId, status, nextAttemptAt])
  @@index([workspaceId, recipientEmail, createdAt])
  @@map("notification_jobs")
}

model EmailTemplate {
  id          String            @id @default(cuid())
  workspaceId String
  kind        EmailTemplateKind
  subject     String
  body        String
  isActive    Boolean           @default(true)
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([workspaceId, kind])
  @@index([workspaceId, isActive])
  @@map("email_templates")
}

model Event {
  id                   String         @id @default(cuid())
  workspaceId          String
  coachWorkspaceUserId String?
  title                String
  description          String?
  startsAt             DateTime
  endsAt               DateTime
  capacity             Int?
  priceCents           Int?
  currency             String         @default("usd")
  status               EventStatus    @default(DRAFT)
  workspace            Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  coachWorkspaceUser   WorkspaceUser? @relation(fields: [coachWorkspaceUserId], references: [id], onDelete: SetNull)
  bookings             EventBooking[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([workspaceId, status, startsAt])
  @@index([workspaceId, coachWorkspaceUserId, startsAt])
  @@map("events")
}

model EventBooking {
  id                      String             @id @default(cuid())
  workspaceId             String
  eventId                 String
  memberId                String
  status                  EventBookingStatus @default(BOOKED)
  priceCents              Int?
  currency                String?
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paidAt                  DateTime?
  workspace               Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  event                   Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member                  Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@unique([workspaceId, eventId, memberId], map: "event_bookings_event_member_key")
  @@index([workspaceId, memberId, status])
  @@map("event_bookings")
}

model PrivateLessonSlot {
  id                   String                  @id @default(cuid())
  workspaceId          String
  coachWorkspaceUserId String
  startsAt             DateTime
  endsAt               DateTime
  priceCents           Int?
  currency             String                  @default("usd")
  status               PrivateLessonSlotStatus @default(OPEN)
  workspace            Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  coachWorkspaceUser   WorkspaceUser           @relation(fields: [coachWorkspaceUserId], references: [id], onDelete: Restrict)
  booking              PrivateLessonBooking?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([workspaceId, status, startsAt])
  @@index([workspaceId, coachWorkspaceUserId, startsAt])
  @@map("private_lesson_slots")
}

model PrivateLessonBooking {
  id                      String                     @id @default(cuid())
  workspaceId             String
  privateLessonSlotId     String                     @unique
  memberId                String
  status                  PrivateLessonBookingStatus @default(BOOKED)
  priceCents              Int?
  currency                String?
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paidAt                  DateTime?
  workspace               Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  privateLessonSlot       PrivateLessonSlot          @relation(fields: [privateLessonSlotId], references: [id], onDelete: Cascade)
  member                  Member                     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@index([workspaceId, memberId, status])
  @@map("private_lesson_bookings")
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model StaffInvite {
  id              String            @id @default(cuid())
  workspaceId     String
  invitedByUserId String
  email           String            @db.Citext
  role            UserRole
  status          StaffInviteStatus @default(PENDING)
  token           String            @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedByUser   User              @relation("StaffInviteSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("staff_invites")
}

model WorkspaceSetting {
  id                 String    @id @default(cuid())
  workspaceId        String    @unique
  allowMultipleRooms Boolean   @default(false)
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("workspace_settings")
}
