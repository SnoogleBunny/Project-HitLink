model User {
  publishedFormRequirements       FormRequirementRevision[] @relation("FormRequirementPublisher")
  openedFormRecoveries            BookingFormRecovery[]     @relation("FormRecoveryOpener")
  paymentConfirmations            PaymentConfirmation[]
  passwordResetChallenges         PasswordResetChallenge[]
  financialAccounts               FinancialAccount[]
  financialOperations             FinancialOperation[]
  id                              String                    @id @default(cuid())
  email                           String                    @unique @db.Citext
  fullName                        String?
  passwordHash                    String?
  member                          Member?
  memberPortalGrants              MemberPortalGrant[]
  workspaceUsers                  WorkspaceUser[]
  authSessions                    AuthSession[]
  sentStaffInvites                StaffInvite[]             @relation("StaffInviteSender")
  migrationReviewAcknowledgements WorkspaceMigration[]      @relation("MigrationOwnerReviewAcknowledgement")
  createdAt                       DateTime                  @default(now())
  updatedAt                       DateTime                  @updatedAt

  @@map("users")
}

model PasswordResetChallenge {
  id            String                @id @default(cuid())
  userId        String
  tokenHash     String                @unique
  emailHash     String
  portal        String
  expiresAt     DateTime
  consumedAt    DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime              @default(now())
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  delivery      AuthRecoveryDelivery?

  @@index([userId, createdAt])
  @@map("password_reset_challenges")
}

model AuthRecoveryDelivery {
  id                String                 @id @default(cuid())
  challengeId       String                 @unique
  recipientEmail    String
  body              String
  status            String                 @default("PENDING")
  attempts          Int                    @default(0)
  leaseVersion      Int                    @default(0)
  leaseExpiresAt    DateTime?
  nextAttemptAt     DateTime               @default(now())
  expiresAt         DateTime
  sentAt            DateTime?
  providerMessageId String?
  failureCode       String?
  createdAt         DateTime               @default(now())
  challenge         PasswordResetChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("auth_recovery_deliveries")
}

// Global account-security evidence stays separate from business/customer exports.
// The additive migration makes rows append-only at the database boundary.
model AccountSecurityEvent {
  id                  String   @id @default(cuid())
  userId              String?
  emailHash           String?
  kind                String
  portal              String?
  challengeId         String?
  revokedSessionCount Int      @default(0)
  createdAt           DateTime @default(now())

  @@index([emailHash, kind, createdAt])
  @@index([userId, createdAt])
  @@map("account_security_events")
}

model Workspace {
  coachingBookingPolicy             CoachingBookingPolicy?
  formRequirementRevisions          FormRequirementRevision[]
  bookingFormRecoveries             BookingFormRecovery[]
  memberOperationalRevisions        MemberOperationalRevision[]
  paymentConfirmations              PaymentConfirmation[]
  memberEmergencyContacts           MemberEmergencyContact[]
  memberProfileEvents               MemberProfileEvent[]
  schedulingPolicyRevisions         WorkspaceSchedulingPolicyRevision[]
  staffTimeOff                      StaffTimeOff[]
  sourceMembershipLifecycleEvidence SourceMembershipLifecycleEvidence[]
  importedFinancialEvidence         ImportedFinancialEvidence[]
  importedBookingFunding            ImportedBookingFunding[]
  importedSignatureEvidence         ImportedSignatureEvidence[]
  sourceBillingEvidence             SourceBillingEvidence[]
  allowanceOpeningBalances          MembershipAllowanceOpeningBalance[]
  programPromotions                 ProgramPromotion[]
  programRankChanges                ProgramRankChange[]
  prerequisiteExceptions            ClassPrerequisiteException[]
  migrationCutoverSnapshots         MigrationCutoverSnapshot[]

  dataExports                 WorkspaceDataExport[]
  memberDataExports           MemberDataExport[]
  billingHandovers            WorkspaceBillingHandover[]
  offboarding                 WorkspaceOffboarding?
  platformBilling             WorkspacePlatformBilling?
  supportGrants               SupportAccessGrant[]
  dataEvents                  WorkspaceDataEvent[]
  membershipLifecycleRequests MembershipLifecycleRequest[]
  financialAccounts           FinancialAccount[]
  financialOperations         FinancialOperation[]
  financialOperationEvents    FinancialOperationEvent[]
  financialReviewCases        FinancialReviewCase[]
  paymentDisputes             PaymentDispute[]
  paymentDisputeEvents        PaymentDisputeEvent[]
  paymentDisputeAllocations   PaymentDisputeAllocation[]
  website                     WorkspaceWebsite?
  websitePublications         WebsitePublication[]
  publicEnrollments           PublicEnrollment[]
  coachingPrograms            CoachingProgram[]
  coachingEnrollments         CoachingEnrollment[]
  coachingAvailability        CoachingAvailability[]
  coachingAppointments        CoachingAppointment[]
  coachingEvents              CoachingEvent[]
  coachingAcceptedPlans       CoachingAcceptedPlan[]
  coachingSettlementDecisions CoachingSettlementDecision[]
  coachingRecordExports       CoachingRecordExport[]
  coachingRecordIncidents     CoachingRecordIncident[]
  coachingRecordReviewGrants  CoachingRecordReviewGrant[]
  coachingRecordAccessEvents  CoachingRecordAccessEvent[]
  coachingPayerGrants         CoachingPayerGrant[]
  coachingDeliveryExceptions  CoachingDeliveryException[]
  coachingAppointmentEvents   CoachingAppointmentEvent[]

  id                                String                               @id @default(cuid())
  name                              String
  businessType                      String?
  logoUrl                           String?
  status                            WorkspaceStatus                      @default(SETUP_INCOMPLETE)
  location                          Location?
  migration                         WorkspaceMigration?
  setup                             WorkspaceSetup?
  setupActivation                   WorkspaceSetupActivation?
  programs                          Program[]
  membershipPlans                   MembershipPlan[]
  membershipPlanProgramRestrictions MembershipPlanProgramRestriction[]
  punchCardProducts                 PunchCardProduct[]
  punchCardProductRestrictions      PunchCardProductProgramRestriction[]
  memberPunchCards                  MemberPunchCard[]
  dropInProducts                    DropInProduct[]
  dropInProductRestrictions         DropInProductProgramRestriction[]
  memberMemberships                 MemberMembership[]
  billingStates                     MembershipBillingState[]
  billingRecords                    BillingRecord[]
  stripeSettings                    WorkspaceStripeSettings?
  stripeWebhookEvents               StripeWebhookEvent[]
  classTemplates                    ClassTemplate[]
  classInstances                    ClassInstance[]
  classScheduleRevisions            ClassScheduleRevision[]
  classScheduleChanges              ClassScheduleChange[]
  members                           Member[]
  guardians                         Guardian[]
  familyLinks                       FamilyLink[]
  memberPortalGrants                MemberPortalGrant[]
  portalAccessChanges               PortalAccessChange[]
  classBookings                     ClassBooking[]
  waitlistEntries                   WaitlistEntry[]
  attendanceRecords                 AttendanceRecord[]
  attendanceOperations              AttendanceOperation[]
  attendanceEvents                  AttendanceEvent[]
  invoices                          Invoice[]
  invoiceLineItems                  InvoiceLineItem[]
  payments                          Payment[]
  refunds                           Refund[]
  accountCredits                    AccountCredit[]
  creditRules                       CreditRule[]
  billingPolicies                   BillingPolicy[]
  paymentMethodReferences           PaymentMethodReference[]
  failedPaymentCases                FailedPaymentCase[]
  importJobs                        ImportJob[]
  importSourceFiles                 ImportSourceFile[]
  importFieldMappings               ImportFieldMapping[]
  stagingRecords                    StagingRecord[]
  validationIssues                  ValidationIssue[]
  reconciliationReports             ReconciliationReport[]
  migrationImportedRecords          MigrationImportedRecord[]
  progressModuleSetting             ProgressModuleSetting?
  beltDefinitions                   BeltDefinition[]
  memberProgressStates              MemberProgressState[]
  promotionRecords                  PromotionRecord[]
  conversationThreads               ConversationThread[]
  conversationParticipants          ConversationParticipant[]
  messages                          Message[]
  announcements                     Announcement[]
  notificationJobs                  NotificationJob[]
  emailTemplates                    EmailTemplate[]
  events                            Event[]
  eventBookings                     EventBooking[]
  privateLessonSlots                PrivateLessonSlot[]
  privateLessonBookings             PrivateLessonBooking[]
  formDocuments                     FormDocument[]
  formVersions                      FormVersion[]
  requiredFormAssignments           RequiredFormAssignment[]
  signatureRequests                 SignatureRequest[]
  signedDocuments                   SignedDocument[]
  workspaceUsers                    WorkspaceUser[]
  staffInvites                      StaffInvite[]
  settings                          WorkspaceSetting?
  timezoneRevisions                 WorkspaceTimezoneRevision[]
  createdAt                         DateTime                             @default(now())
  updatedAt                         DateTime                             @updatedAt

  @@map("workspaces")
}

model WorkspaceMigration {
  reviewedCutoverSnapshotId String?

  id                              String         @id @default(cuid())
  workspaceId                     String         @unique
  stage                           MigrationStage @default(INTAKE_RECEIVED)
  currentSoftware                 String?
  targetGoLiveDate                DateTime?      @db.Date
  memberCountEstimate             Int?
  billingStatus                   String?
  scheduleComplexity              String?
  formsAndWaivers                 String?
  dataScope                       String[]       @default([])
  accessInstructions              String?
  nextOwnerAction                 String
  flowstateResponsibility         String
  expectedNextMilestone           String?
  expectedNextMilestoneAt         DateTime?
  goLiveScheduledFor              DateTime?      @db.Date
  ownerReviewAcknowledgedAt       DateTime?
  ownerReviewAcknowledgedByUserId String?
  operationallyReadyAt            DateTime?
  operationallyReadyByUserId      String?
  workspace                       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerReviewAcknowledgedByUser   User?          @relation("MigrationOwnerReviewAcknowledgement", fields: [ownerReviewAcknowledgedByUserId], references: [id], onDelete: Restrict, map: "workspace_migrations_owner_review_user_fkey")
  createdAt                       DateTime       @default(now())
  updatedAt                       DateTime       @updatedAt

  @@index([stage, updatedAt])
  @@map("workspace_migrations")
}

model Location {
  id           String    @id @default(cuid())
  workspaceId  String    @unique
  name         String
  timezone     String
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  countryCode  String?
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rooms        Room[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("locations")
}

model Room {
  coachingAvailability CoachingAvailability[]
  coachingAppointments CoachingAppointment[]

  id                String                  @id @default(cuid())
  locationId        String
  name              String
  capacity          Int?
  isActive          Boolean                 @default(true)
  archivedAt        DateTime?
  location          Location                @relation(fields: [locationId], references: [id], onDelete: Cascade)
  classTemplates    ClassTemplate[]
  classInstances    ClassInstance[]
  scheduleRevisions ClassScheduleRevision[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([locationId, name])
  @@map("rooms")
}

model Program {
  rankPolicy        Json?
  programPromotions ProgramPromotion[]
  rankChanges       ProgramRankChange[]

  id                           String                               @id @default(cuid())
  workspaceId                  String
  name                         String
  description                  String?
  ageGroupLabel                String?
  levelLabel                   String?
  progressTrackingEnabled      Boolean                              @default(false)
  archivedAt                   DateTime?
  workspace                    Workspace                            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  classTemplates               ClassTemplate[]
  classInstances               ClassInstance[]
  scheduleRevisions            ClassScheduleRevision[]
  membershipPlanRestrictions   MembershipPlanProgramRestriction[]
  punchCardProductRestrictions PunchCardProductProgramRestriction[]
  dropInProductRestrictions    DropInProductProgramRestriction[]
  createdAt                    DateTime                             @default(now())
  updatedAt                    DateTime                             @updatedAt

  @@unique([workspaceId, name])
  @@map("programs")
}

model WorkspaceUser {
  assignedFormRecoveries    BookingFormRecovery[]        @relation("FormRecoveryReviewer")
  reviewedPaymentDisputes   PaymentDispute[]
  staffTimeOff              StaffTimeOff[]
  canManageProgress         Boolean                      @default(false)
  canOverridePrerequisites  Boolean                      @default(false)
  awardedProgramPromotions  ProgramPromotion[]           @relation("ProgramAwarder")
  recordedProgramPromotions ProgramPromotion[]           @relation("ProgramRecorder")
  programRankChanges        ProgramRankChange[]
  prerequisiteExceptions    ClassPrerequisiteException[]

  currentCoachingEnrollments  CoachingEnrollment[]        @relation("CurrentCoachingCoach")
  proposedCoachingEnrollments CoachingEnrollment[]        @relation("ProposedCoachingCoach")
  coachingCases               CoachingEnrollment[]        @relation("CoachingCaseOwner")
  coachingAssignments         CoachingAssignment[]
  coachingDailyNotes          CoachingDailyNote[]
  coachingDailyRevisions      CoachingDailyNoteRevision[]
  coachingPrivateNotes        CoachingPrivateNote[]
  coachingAvailability        CoachingAvailability[]
  coachingAppointments        CoachingAppointment[]

  id                       String                  @id @default(cuid())
  workspaceId              String
  userId                   String                  @unique
  role                     UserRole
  isActive                 Boolean                 @default(true)
  workspace                Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachedClassTemplates    ClassTemplate[]
  coachedClassInstances    ClassInstance[]
  coachedScheduleRevisions ClassScheduleRevision[]
  classScheduleChanges     ClassScheduleChange[]
  verifiedPortalGrants     MemberPortalGrant[]
  portalAccessChanges      PortalAccessChange[]
  eventCoachAssignments    Event[]
  privateLessonSlots       PrivateLessonSlot[]
  coachedAttendanceRecords AttendanceRecord[]
  uploadedFormVersions     FormVersion[]           @relation("UploadedFormVersions")
  createdSignatureRequests SignatureRequest[]      @relation("SignatureRequestCreator")
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@unique([workspaceId, userId])
  @@unique([workspaceId, id])
  @@map("workspace_users")
}

model ClassTemplate {
  prerequisites          Json?
  prerequisiteExceptions ClassPrerequisiteException[]

  id                        String                  @id @default(cuid())
  workspaceId               String
  programId                 String
  roomId                    String
  coachWorkspaceUserId      String?
  title                     String?
  weekday                   Weekday
  startTimeMinutes          Int
  endTimeMinutes            Int
  capacityOverride          Int?
  bookingCutoffMinutes      Int
  cancellationCutoffMinutes Int
  archivedAt                DateTime?
  scheduleStartsOn          DateTime?               @db.Date
  scheduleVersion           Int                     @default(0)
  workspace                 Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  program                   Program                 @relation(fields: [programId], references: [id])
  room                      Room                    @relation(fields: [roomId], references: [id])
  coachWorkspaceUser        WorkspaceUser?          @relation(fields: [coachWorkspaceUserId], references: [id], onDelete: Restrict)
  scheduleRevisions         ClassScheduleRevision[]
  scheduleChanges           ClassScheduleChange[]
  classInstances            ClassInstance[]
  classBookings             ClassBooking[]
  waitlistEntries           WaitlistEntry[]
  attendanceRecords         AttendanceRecord[]
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, weekday])
  @@index([coachWorkspaceUserId])
  @@index([roomId])
  @@index([programId])
  @@map("class_templates")
}

model Member {
  operationalRevisions         MemberOperationalRevision[]
  profileVersion               Int                          @default(0)
  emergencyContacts            MemberEmergencyContact[]
  profileEvents                MemberProfileEvent[]
  importedFinancialBeneficiary ImportedFinancialEvidence[]  @relation("ImportedFinancialBeneficiary")
  importedFinancialPayer       ImportedFinancialEvidence[]  @relation("ImportedFinancialPayer")
  importedSignatures           ImportedSignatureEvidence[]
  programPromotions            ProgramPromotion[]
  prerequisiteExceptions       ClassPrerequisiteException[]

  financialAccounts    FinancialAccount[]
  financialOperations  FinancialOperation[]
  financialReviewCases FinancialReviewCase[]
  publicEnrollments    PublicEnrollment[]
  coachingEnrollments  CoachingEnrollment[]

  id                       String                    @id @default(cuid())
  workspaceId              String
  userId                   String?                   @unique
  fullName                 String
  email                    String?                   @db.Citext
  phone                    String?
  dateOfBirth              DateTime?                 @db.Date
  status                   MemberStatus              @default(TRIAL)
  archivedAt               DateTime?
  archiveVersion           Int                       @default(0)
  notes                    String?
  tags                     String[]                  @default([])
  workspace                Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                     User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  familyLinks              FamilyLink[]              @relation("ChildMemberFamilyLinks")
  portalGrants             MemberPortalGrant[]
  punchCards               MemberPunchCard[]
  memberships              MemberMembership[]
  billingStates            MembershipBillingState[]
  billingRecords           BillingRecord[]
  invoices                 Invoice[]
  payments                 Payment[]
  refunds                  Refund[]
  accountCredits           AccountCredit[]
  failedPaymentCases       FailedPaymentCase[]
  progressState            MemberProgressState?
  promotionRecords         PromotionRecord[]
  conversationParticipants ConversationParticipant[]
  messages                 Message[]
  eventBookings            EventBooking[]
  privateLessonBookings    PrivateLessonBooking[]
  classBookings            ClassBooking[]
  waitlistEntries          WaitlistEntry[]
  attendanceRecords        AttendanceRecord[]
  signatureRequests        SignatureRequest[]
  signedDocuments          SignedDocument[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@unique([workspaceId, id])
  @@index([workspaceId, status])
  @@index([workspaceId, fullName])
  @@index([workspaceId, archivedAt, fullName])
  @@index([workspaceId, email])
  @@index([workspaceId, userId])
  @@map("members")
}

model Guardian {
  importedSignatures       ImportedSignatureEvidence[]
  id                       String                      @id @default(cuid())
  workspaceId              String
  fullName                 String
  email                    String?                     @db.Citext
  phone                    String?
  notes                    String?
  workspace                Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  familyLinks              FamilyLink[]
  portalGrants             MemberPortalGrant[]
  classBookings            ClassBooking[]
  conversationParticipants ConversationParticipant[]
  messages                 Message[]
  signatureRequests        SignatureRequest[]
  signedDocuments          SignedDocument[]
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  @@index([workspaceId, fullName])
  @@index([workspaceId, email])
  @@map("guardians")
}

model FamilyLink {
  id                String    @id @default(cuid())
  workspaceId       String
  guardianId        String
  childMemberId     String
  relationshipLabel String?
  isPrimary         Boolean   @default(false)
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  guardian          Guardian  @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  childMember       Member    @relation("ChildMemberFamilyLinks", fields: [childMemberId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([guardianId, childMemberId])
  @@index([workspaceId, childMemberId])
  @@index([workspaceId, guardianId])
  @@map("family_links")
}

model MemberPortalGrant {
  canManageEmergencyContacts Boolean              @default(false)
  id                         String               @id @default(cuid())
  workspaceId                String
  userId                     String
  memberId                   String
  guardianId                 String
