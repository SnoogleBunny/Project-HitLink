  memberId             String
  scheduledForDate     DateTime      @db.Date
  policyFingerprint    String
  actorWorkspaceUserId String
  reason               String
  createdAt            DateTime      @default(now())
  workspace            Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  classTemplate        ClassTemplate @relation(fields: [classTemplateId], references: [id], onDelete: Restrict)
  member               Member        @relation(fields: [memberId], references: [id], onDelete: Restrict)
  actorWorkspaceUser   WorkspaceUser @relation(fields: [actorWorkspaceUserId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, classTemplateId, memberId, scheduledForDate, policyFingerprint], map: "class_prerequisite_exception_policy_key")
  @@map("class_prerequisite_exceptions")
}

model MigrationCutoverSnapshot {
