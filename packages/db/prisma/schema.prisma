generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  COACH
  CUSTOMER
}

enum WorkspaceStatus {
  SETUP_INCOMPLETE
  ACTIVE
  DISABLED
}

enum StaffInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MemberStatus {
  ACTIVE
  TRIAL
  OVERDUE
  FROZEN
  CANCELLED
  WAITLISTED
}

enum MemberFormStatus {
  NOT_REQUESTED
  PENDING
  COMPLETE
}

enum ClassBookingType {
  TRIAL
  MEMBERSHIP
  PUNCH_CARD
  DROP_IN
}

enum ClassBookingStatus {
  PENDING_PAYMENT
  BOOKED
  CANCELLED
  ATTENDED
  ABSENT
  NO_SHOW
}

enum ClassBookingSource {
  ADMIN
  PUBLIC_TRIAL
  MEMBER_PORTAL
}

enum AttendanceState {
  PRESENT
  LATE
  ABSENT
  NO_SHOW
}

enum MemberMembershipStatus {
  ACTIVE
  PENDING_PAYMENT_METHOD
  PAST_DUE
  FROZEN
  CANCELLED
  ENDED
}

enum StripeConnectionStatus {
  NOT_CONNECTED
  PENDING
  ACTIVE
  RESTRICTED
  DISCONNECTED
}

enum BillingStateStatus {
  NOT_READY
  ACTIVE
  PENDING_PAYMENT_METHOD
  PAST_DUE
  PAYMENT_FAILED
  ACTION_REQUIRED
  FROZEN
  CANCELLED
  ENDED
}

enum BillingRecordType {
  MEMBERSHIP_ASSIGNED
  MEMBERSHIP_CANCELLED
  MEMBERSHIP_FROZEN
  MEMBERSHIP_UNFROZEN
  PUNCH_CARD_PURCHASED
  PUNCH_CARD_GRANTED
  DROP_IN_PURCHASED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_UPDATED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  PAYMENT_ACTION_REQUIRED
  PAYMENT_UPDATE_REQUESTED
  RETRY_REQUESTED
  STRIPE_ACCOUNT_UPDATED
  STRIPE_ACCOUNT_DISCONNECTED
}

enum BillingRecordStatus {
  INFO
  PENDING
  SUCCEEDED
  FAILED
  ACTION_REQUIRED
}

enum StripeWebhookProcessingStatus {
  PROCESSING
  PROCESSED
  ERROR
}

enum AccessRestrictionMode {
  GENERAL
  PROGRAM_RESTRICTED
}

enum MemberPunchCardStatus {
  ACTIVE
  DEPLETED
  ARCHIVED
}

enum WaitlistEntryStatus {
  ACTIVE
  PROMOTED
  CANCELLED
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique @db.Citext
  fullName         String?
  passwordHash     String?
  member           Member?
  workspaceUsers   WorkspaceUser[]
  authSessions     AuthSession[]
  sentStaffInvites StaffInvite[]   @relation("StaffInviteSender")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("users")
}

model Workspace {
  id                                String                             @id @default(cuid())
  name                              String
  businessType                      String?
  logoUrl                           String?
  status                            WorkspaceStatus                    @default(SETUP_INCOMPLETE)
  location                          Location?
  programs                          Program[]
  membershipPlans                   MembershipPlan[]
  membershipPlanProgramRestrictions MembershipPlanProgramRestriction[]
  punchCardProducts                 PunchCardProduct[]
  punchCardProductRestrictions      PunchCardProductProgramRestriction[]
  memberPunchCards                  MemberPunchCard[]
  dropInProducts                    DropInProduct[]
  dropInProductRestrictions         DropInProductProgramRestriction[]
  memberMemberships                 MemberMembership[]
  billingStates                     MembershipBillingState[]
  billingRecords                    BillingRecord[]
  stripeSettings                    WorkspaceStripeSettings?
  stripeWebhookEvents               StripeWebhookEvent[]
  classTemplates                    ClassTemplate[]
  members                           Member[]
  guardians                         Guardian[]
  familyLinks                       FamilyLink[]
  classBookings                     ClassBooking[]
  waitlistEntries                   WaitlistEntry[]
  attendanceRecords                 AttendanceRecord[]
  workspaceUsers                    WorkspaceUser[]
  staffInvites                      StaffInvite[]
  settings                          WorkspaceSetting?
  createdAt                         DateTime                           @default(now())
  updatedAt                         DateTime                           @updatedAt

  @@map("workspaces")
}

model Location {
  id           String    @id @default(cuid())
  workspaceId  String    @unique
  name         String
  timezone     String
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  countryCode  String?
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rooms        Room[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("locations")
}

model Room {
  id             String          @id @default(cuid())
  locationId     String
  name           String
  capacity       Int?
  isActive       Boolean         @default(true)
  archivedAt     DateTime?
  location       Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  classTemplates ClassTemplate[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([locationId, name])
  @@map("rooms")
}

model Program {
  id                         String                             @id @default(cuid())
  workspaceId                String
  name                       String
  description                String?
  ageGroupLabel              String?
  levelLabel                 String?
  progressTrackingEnabled    Boolean                            @default(false)
  archivedAt                 DateTime?
  workspace                  Workspace                          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  classTemplates             ClassTemplate[]
  membershipPlanRestrictions MembershipPlanProgramRestriction[]
  punchCardProductRestrictions PunchCardProductProgramRestriction[]
  dropInProductRestrictions  DropInProductProgramRestriction[]
  createdAt                  DateTime                           @default(now())
  updatedAt                  DateTime                           @updatedAt

  @@unique([workspaceId, name])
  @@map("programs")
}

model WorkspaceUser {
  id                       String             @id @default(cuid())
  workspaceId              String
  userId                   String             @unique
  role                     UserRole
  isActive                 Boolean            @default(true)
  workspace                Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachedClassTemplates    ClassTemplate[]
  coachedAttendanceRecords AttendanceRecord[]
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@unique([workspaceId, userId])
  @@map("workspace_users")
}

model ClassTemplate {
  id                        String             @id @default(cuid())
  workspaceId               String
  programId                 String
  roomId                    String
  coachWorkspaceUserId      String
  title                     String?
  weekday                   Weekday
  startTimeMinutes          Int
  endTimeMinutes            Int
  capacityOverride          Int?
  bookingCutoffMinutes      Int
  cancellationCutoffMinutes Int
  archivedAt                DateTime?
  workspace                 Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  program                   Program            @relation(fields: [programId], references: [id])
  room                      Room               @relation(fields: [roomId], references: [id])
  coachWorkspaceUser        WorkspaceUser      @relation(fields: [coachWorkspaceUserId], references: [id])
  classBookings             ClassBooking[]
  waitlistEntries           WaitlistEntry[]
  attendanceRecords         AttendanceRecord[]
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, weekday])
  @@index([coachWorkspaceUserId])
  @@index([roomId])
  @@index([programId])
  @@map("class_templates")
}

model Member {
  id                String                   @id @default(cuid())
  workspaceId       String
  userId            String?                  @unique
  fullName          String
  email             String?                  @db.Citext
  phone             String?
  dateOfBirth       DateTime?                @db.Date
  status            MemberStatus             @default(TRIAL)
  notes             String?
  tags              String[]                 @default([])
  formStatus        MemberFormStatus         @default(NOT_REQUESTED)
  workspace         Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  familyLinks       FamilyLink[]             @relation("ChildMemberFamilyLinks")
  punchCards        MemberPunchCard[]
  memberships       MemberMembership[]
  billingStates     MembershipBillingState[]
  billingRecords    BillingRecord[]
  classBookings     ClassBooking[]
  waitlistEntries   WaitlistEntry[]
  attendanceRecords AttendanceRecord[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([workspaceId, status])
  @@index([workspaceId, fullName])
  @@index([workspaceId, email])
  @@index([workspaceId, userId])
  @@map("members")
}

model Guardian {
  id            String         @id @default(cuid())
  workspaceId   String
  fullName      String
  email         String?        @db.Citext
  phone         String?
  notes         String?
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  familyLinks   FamilyLink[]
  classBookings ClassBooking[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([workspaceId, fullName])
  @@index([workspaceId, email])
  @@map("guardians")
}

model FamilyLink {
  id                String    @id @default(cuid())
  workspaceId       String
  guardianId        String
  childMemberId     String
  relationshipLabel String?
  isPrimary         Boolean   @default(false)
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  guardian          Guardian  @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  childMember       Member    @relation("ChildMemberFamilyLinks", fields: [childMemberId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([guardianId, childMemberId])
  @@index([workspaceId, childMemberId])
  @@index([workspaceId, guardianId])
  @@map("family_links")
}

model ClassBooking {
  id                     String             @id @default(cuid())
  workspaceId            String
  memberId               String
  guardianId             String?
  classTemplateId        String
  memberPunchCardId      String?
  dropInProductId        String?
  scheduledForDate       DateTime           @db.Date
  bookingType            ClassBookingType   @default(MEMBERSHIP)
  status                 ClassBookingStatus @default(BOOKED)
  source                 ClassBookingSource @default(ADMIN)
  consumedPunchCount     Int                @default(0)
  dropInPriceCents       Int?
  dropInCurrency         String?
  dropInCheckoutSessionId String?
  dropInPaymentIntentId  String?
  dropInPaidAt           DateTime?
  pendingPaymentExpiresAt DateTime?
  workspace              Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member                 Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  guardian               Guardian?          @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  classTemplate          ClassTemplate      @relation(fields: [classTemplateId], references: [id], onDelete: Restrict)
  memberPunchCard        MemberPunchCard?   @relation(fields: [memberPunchCardId], references: [id], onDelete: SetNull)
  dropInProduct          DropInProduct?     @relation(fields: [dropInProductId], references: [id], onDelete: SetNull)
  promotedWaitlistEntries WaitlistEntry[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([workspaceId, memberId, classTemplateId, scheduledForDate], map: "class_bookings_member_template_date_key")
  @@index([workspaceId, scheduledForDate])
  @@index([workspaceId, classTemplateId, scheduledForDate])
  @@index([workspaceId, memberId])
  @@index([workspaceId, status, pendingPaymentExpiresAt])
  @@index([workspaceId, memberPunchCardId])
  @@index([workspaceId, dropInProductId])
  @@map("class_bookings")
}

model AttendanceRecord {
  id                   String          @id @default(cuid())
  workspaceId          String
  memberId             String
  classTemplateId      String
  scheduledForDate     DateTime        @db.Date
  state                AttendanceState
  coachWorkspaceUserId String?
  note                 String?
  workspace            Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member               Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  classTemplate        ClassTemplate   @relation(fields: [classTemplateId], references: [id], onDelete: Restrict)
  coachWorkspaceUser   WorkspaceUser?  @relation(fields: [coachWorkspaceUserId], references: [id], onDelete: SetNull)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@unique([workspaceId, memberId, classTemplateId, scheduledForDate], map: "attendance_records_member_template_date_key")
  @@index([workspaceId, classTemplateId, scheduledForDate])
  @@index([workspaceId, memberId])
  @@index([coachWorkspaceUserId])
  @@map("attendance_records")
}

model MembershipPlan {
  id                          String                             @id @default(cuid())
  workspaceId                 String
  name                        String
  description                 String?
  monthlyPriceCents           Int
  currency                    String                             @default("usd")
  cancellationPolicyReference String?
  freezePolicyReference       String?
  stripeProductId             String?
  stripePriceId               String?
  archivedAt                  DateTime?
  workspace                   Workspace                          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  programRestrictions         MembershipPlanProgramRestriction[]
  memberMemberships           MemberMembership[]
  createdAt                   DateTime                           @default(now())
  updatedAt                   DateTime                           @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId, archivedAt])
  @@map("membership_plans")
}

model MembershipPlanProgramRestriction {
  id               String         @id @default(cuid())
  workspaceId      String
  membershipPlanId String
  programId        String
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  membershipPlan   MembershipPlan @relation(fields: [membershipPlanId], references: [id], onDelete: Cascade)
  program          Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([membershipPlanId, programId], map: "membership_plan_program_restrictions_plan_program_key")
  @@index([workspaceId, membershipPlanId])
  @@index([workspaceId, programId])
  @@map("membership_plan_program_restrictions")
}

model PunchCardProduct {
  id                  String                   @id @default(cuid())
  workspaceId         String
  name                String
  description         String?
  punchesIncluded     Int
  priceCents          Int
  currency            String                   @default("usd")
  isEnabled           Boolean                  @default(true)
  archivedAt          DateTime?
  restrictionMode     AccessRestrictionMode    @default(GENERAL)
  stripeProductId     String?
  stripePriceId       String?
  workspace           Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  programRestrictions PunchCardProductProgramRestriction[]
  memberPunchCards    MemberPunchCard[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, isEnabled, archivedAt])
  @@map("punch_card_products")
}

model PunchCardProductProgramRestriction {
  id                 String           @id @default(cuid())
  workspaceId        String
  punchCardProductId String
  programId          String
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  punchCardProduct   PunchCardProduct @relation(fields: [punchCardProductId], references: [id], onDelete: Cascade)
  program            Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([punchCardProductId, programId], map: "punch_card_product_program_restrictions_product_program_key")
  @@index([workspaceId, punchCardProductId])
  @@index([workspaceId, programId])
  @@map("punch_card_product_program_restrictions")
}

model MemberPunchCard {
  id                  String                @id @default(cuid())
  workspaceId         String
  memberId            String
  punchCardProductId  String
  originalPunches     Int
  remainingPunches    Int
  status              MemberPunchCardStatus @default(ACTIVE)
  purchasePriceCents  Int
  purchaseCurrency    String                @default("usd")
  purchasedAt         DateTime              @default(now())
  stripeCheckoutSessionId String?
  workspace           Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member              Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  punchCardProduct    PunchCardProduct      @relation(fields: [punchCardProductId], references: [id], onDelete: Restrict)
  classBookings       ClassBooking[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([workspaceId, memberId, status, purchasedAt])
  @@index([workspaceId, punchCardProductId])
  @@index([workspaceId, stripeCheckoutSessionId])
  @@map("member_punch_cards")
}

model DropInProduct {
  id                  String                    @id @default(cuid())
  workspaceId         String
  name                String
  description         String?
  priceCents          Int
  currency            String                    @default("usd")
  isEnabled           Boolean                   @default(true)
  archivedAt          DateTime?
  restrictionMode     AccessRestrictionMode     @default(GENERAL)
  stripeProductId     String?
  stripePriceId       String?
  workspace           Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  programRestrictions DropInProductProgramRestriction[]
  classBookings       ClassBooking[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, isEnabled, archivedAt])
  @@map("drop_in_products")
}

model DropInProductProgramRestriction {
  id            String        @id @default(cuid())
  workspaceId   String
  dropInProductId String
  programId     String
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dropInProduct DropInProduct @relation(fields: [dropInProductId], references: [id], onDelete: Cascade)
  program       Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([dropInProductId, programId], map: "drop_in_product_program_restrictions_product_program_key")
  @@index([workspaceId, dropInProductId])
  @@index([workspaceId, programId])
  @@map("drop_in_product_program_restrictions")
}

model WaitlistEntry {
  id               String              @id @default(cuid())
  workspaceId      String
  memberId         String
  classTemplateId  String
  scheduledForDate DateTime            @db.Date
  status           WaitlistEntryStatus @default(ACTIVE)
  joinedAt         DateTime            @default(now())
  promotedAt       DateTime?
  promotedBookingId String?
  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member           Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  classTemplate    ClassTemplate       @relation(fields: [classTemplateId], references: [id], onDelete: Restrict)
  promotedBooking  ClassBooking?       @relation(fields: [promotedBookingId], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([workspaceId, memberId, classTemplateId, scheduledForDate], map: "waitlist_entries_member_template_date_key")
  @@index([workspaceId, classTemplateId, scheduledForDate, status, joinedAt])
  @@index([workspaceId, memberId, status])
  @@index([workspaceId, promotedBookingId])
  @@map("waitlist_entries")
}

model MemberMembership {
  id                    String                  @id @default(cuid())
  workspaceId           String
  memberId              String
  membershipPlanId      String
  status                MemberMembershipStatus  @default(ACTIVE)
  startedAt             DateTime                @default(now())
  endedAt               DateTime?
  nextBillingDate       DateTime?
  cancelAtPeriodEnd     Boolean                 @default(false)
  cancelRequestedAt     DateTime?
  frozenFrom            DateTime?               @db.Date
  frozenUntil           DateTime?               @db.Date
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  currentMembershipSlot String?                 @default("CURRENT")
  workspace             Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member                Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membershipPlan        MembershipPlan          @relation(fields: [membershipPlanId], references: [id], onDelete: Restrict)
  billingState          MembershipBillingState?
  billingRecords        BillingRecord[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@unique([workspaceId, memberId, currentMembershipSlot], map: "member_memberships_one_current_key")
  @@index([workspaceId, status])
  @@index([workspaceId, memberId])
  @@index([workspaceId, stripeCustomerId])
  @@index([workspaceId, stripeSubscriptionId])
  @@map("member_memberships")
}

model WorkspaceStripeSettings {
  id                           String                 @id @default(cuid())
  workspaceId                  String                 @unique
  stripeAccountId              String?
  connectionStatus             StripeConnectionStatus @default(NOT_CONNECTED)
  chargesEnabled               Boolean                @default(false)
  payoutsEnabled               Boolean                @default(false)
  detailsSubmitted             Boolean                @default(false)
  failedPaymentGracePeriodDays Int                    @default(7)
  workspace                    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt

  @@index([stripeAccountId])
  @@map("workspace_stripe_settings")
}

model MembershipBillingState {
  id                       String               @id @default(cuid())
  workspaceId              String
  memberId                 String
  memberMembershipId       String               @unique
  status                   BillingStateStatus   @default(NOT_READY)
  nextBillingDate          DateTime?
  latestInvoiceId          String?
  latestPaymentIntentId    String?
  latestSubscriptionId     String?
  lastPaymentStatus        BillingRecordStatus?
  lastPaymentAt            DateTime?
  failureCode              String?
  failureMessage           String?
  failedAt                 DateTime?
  gracePeriodEndsAt        DateTime?
  paymentUpdateRequestedAt DateTime?
  retryRequestedAt         DateTime?
  workspace                Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member                   Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberMembership         MemberMembership     @relation(fields: [memberMembershipId], references: [id], onDelete: Cascade)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([workspaceId, status])
  @@index([workspaceId, memberId])
  @@index([workspaceId, latestInvoiceId])
  @@index([workspaceId, latestSubscriptionId])
  @@map("membership_billing_states")
}

model BillingRecord {
  id                    String              @id @default(cuid())
  workspaceId           String
  memberId              String?
  memberMembershipId    String?
  type                  BillingRecordType
  status                BillingRecordStatus @default(INFO)
  amountCents           Int?
  currency              String?
  occurredAt            DateTime            @default(now())
  stripeEventId         String?
  stripeInvoiceId       String?
  stripePaymentIntentId String?
  stripeSubscriptionId  String?
  failureCode           String?
  failureMessage        String?
  workspace             Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member                Member?             @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberMembership      MemberMembership?   @relation(fields: [memberMembershipId], references: [id], onDelete: SetNull)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([workspaceId, occurredAt])
  @@index([workspaceId, memberId])
  @@index([workspaceId, memberMembershipId])
  @@index([workspaceId, stripeInvoiceId])
  @@index([workspaceId, stripeSubscriptionId])
  @@map("billing_records")
}

model StripeWebhookEvent {
  id              String                        @id @default(cuid())
  workspaceId     String?
  stripeAccountId String?
  stripeEventId   String                        @unique
  eventType       String
  livemode        Boolean
  status          StripeWebhookProcessingStatus @default(PROCESSING)
  receivedAt      DateTime                      @default(now())
  processedAt     DateTime?
  attemptCount    Int                           @default(0)
  lastError       String?
  workspace       Workspace?                    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  @@index([status, receivedAt])
  @@index([stripeAccountId])
  @@index([workspaceId])
  @@map("stripe_webhook_events")
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model StaffInvite {
  id              String            @id @default(cuid())
  workspaceId     String
  invitedByUserId String
  email           String            @db.Citext
  role            UserRole
  status          StaffInviteStatus @default(PENDING)
  token           String            @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedByUser   User              @relation("StaffInviteSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("staff_invites")
}

model WorkspaceSetting {
  id                 String    @id @default(cuid())
  workspaceId        String    @unique
  allowMultipleRooms Boolean   @default(false)
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("workspace_settings")
}
