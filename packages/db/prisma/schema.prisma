generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  COACH
  CUSTOMER
}

enum WorkspaceStatus {
  SETUP_INCOMPLETE
  ACTIVE
  DISABLED
}

enum MigrationStage {
  INTAKE_RECEIVED
  EXPORTS_NEEDED
  MIGRATION_IN_PROGRESS
  REVIEW_READY
  GO_LIVE_SCHEDULED
  COMPLETE
}

enum StaffInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MemberStatus {
  ACTIVE
  TRIAL
  OVERDUE
  FROZEN
  CANCELLED
  WAITLISTED
}

enum ClassBookingType {
  TRIAL
  MEMBERSHIP
  PUNCH_CARD
  DROP_IN
}

enum ClassBookingStatus {
  PENDING_PAYMENT
  BOOKED
  CANCELLED
  ATTENDED
  ABSENT
  NO_SHOW
}

enum ClassInstanceStatus {
  ACTIVE
  CANCELLED
}

enum ClassBookingSource {
  ADMIN
  PUBLIC_TRIAL
  MEMBER_PORTAL
}

enum AttendanceState {
  PRESENT
  LATE
  ABSENT
  NO_SHOW
}

enum MemberMembershipStatus {
  ACTIVE
  PENDING_PAYMENT_METHOD
  PAST_DUE
  FROZEN
  CANCELLED
  ENDED
}

enum StripeConnectionStatus {
  NOT_CONNECTED
  PENDING
  ACTIVE
  RESTRICTED
  DISCONNECTED
}

enum BillingStateStatus {
  NOT_READY
  ACTIVE
  PENDING_PAYMENT_METHOD
  PAST_DUE
  PAYMENT_FAILED
  ACTION_REQUIRED
  FROZEN
  CANCELLED
  ENDED
}

enum BillingRecordType {
  MEMBERSHIP_ASSIGNED
  MEMBERSHIP_CANCELLED
  MEMBERSHIP_FROZEN
  MEMBERSHIP_UNFROZEN
  PUNCH_CARD_PURCHASED
  PUNCH_CARD_GRANTED
  DROP_IN_PURCHASED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_UPDATED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  PAYMENT_ACTION_REQUIRED
  PAYMENT_UPDATE_REQUESTED
  RETRY_REQUESTED
  STRIPE_ACCOUNT_UPDATED
  STRIPE_ACCOUNT_DISCONNECTED
}

enum BillingRecordStatus {
  INFO
  PENDING
  SUCCEEDED
  FAILED
  ACTION_REQUIRED
}

enum BillingSource {
  CURRENT
  IMPORTED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
  IMPORTED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  IMPORTED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  IMPORTED
}

enum AccountCreditStatus {
  ACTIVE
  APPLIED
  EXPIRED
  VOID
}

enum CreditRuleScope {
  ANY
  MEMBERSHIP
  DROP_IN
  PUNCH_CARD
  EVENT
  PRIVATE_LESSON
}

enum FailedPaymentCaseStatus {
  OPEN
  RESOLVED
  CANCELLED
}

enum StripeWebhookProcessingStatus {
  PROCESSING
  PROCESSED
  ERROR
}

enum AccessRestrictionMode {
  GENERAL
  PROGRAM_RESTRICTED
}

enum MemberPunchCardStatus {
  ACTIVE
  DEPLETED
  ARCHIVED
}

enum WaitlistEntryStatus {
  ACTIVE
  PROMOTED
  CANCELLED
}

enum FormType {
  WAIVER
  MEMBERSHIP_AGREEMENT
  CHILD_GUARDIAN_WAIVER
  CUSTOM
}

enum RequirementTarget {
  TRIAL
  MEMBER
  GUARDIAN
  MEMBERSHIP_ACTIVATION
}

enum FormSignerKind {
  MEMBER
  GUARDIAN
}

enum SignatureRequestStatus {
  OPEN
  COMPLETED
  EXPIRED
  CANCELLED
}

enum SignatureAccessMethod {
  PORTAL
  MAGIC_LINK
}

enum ImportSourceType {
  CSV
  ZEN_PLANNER
}

enum ImportJobStatus {
  DRAFT
  MAPPED
  VALIDATED
  DRY_RUN_COMPLETE
  IMPORTING
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportRecordKind {
  MEMBER
  GUARDIAN
  FAMILY_LINK
  MEMBERSHIP_PLAN
  MEMBER_MEMBERSHIP
  BILLING_HISTORY
  PUNCH_CARD_BALANCE
  DROP_IN_PRODUCT
  NOTE
  STAFF
  PROGRESS
  ATTENDANCE
  SCHEDULE_TEMPLATE
}

enum ValidationSeverity {
  INFO
  WARNING
  ERROR
}

enum ProgressModuleStatus {
  DISABLED
  ENABLED
}

enum ConversationThreadStatus {
  OPEN
  CLOSED
}

enum ConversationParticipantKind {
  STAFF
  MEMBER
  GUARDIAN
}

enum MessageSenderKind {
  STAFF
  MEMBER
  GUARDIAN
  SYSTEM
}

enum MessageStatus {
  SENT
  DELETED
}

enum AnnouncementStatus {
  DRAFT
  QUEUED
  SENT
  CANCELLED
}

enum NotificationJobStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum EmailTemplateKind {
  TRIAL_CONFIRMATION
  BOOKING_CONFIRMATION
  CLASS_REMINDER
  FAILED_PAYMENT
  ANNOUNCEMENT
  PAYMENT_METHOD_UPDATE_REQUEST
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventBookingStatus {
  PENDING_PAYMENT
  BOOKED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum PrivateLessonSlotStatus {
  OPEN
  BOOKED
  CANCELLED
}

enum PrivateLessonBookingStatus {
  PENDING_PAYMENT
  BOOKED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique @db.Citext
  fullName         String?
  passwordHash     String?
  member           Member?
  workspaceUsers   WorkspaceUser[]
  authSessions     AuthSession[]
  sentStaffInvites StaffInvite[]   @relation("StaffInviteSender")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("users")
}

model Workspace {
  id                                String                               @id @default(cuid())
  name                              String
  businessType                      String?
  logoUrl                           String?
  status                            WorkspaceStatus                      @default(SETUP_INCOMPLETE)
  location                          Location?
  migration                         WorkspaceMigration?
  programs                          Program[]
  membershipPlans                   MembershipPlan[]
  membershipPlanProgramRestrictions MembershipPlanProgramRestriction[]
  punchCardProducts                 PunchCardProduct[]
  punchCardProductRestrictions      PunchCardProductProgramRestriction[]
  memberPunchCards                  MemberPunchCard[]
  dropInProducts                    DropInProduct[]
  dropInProductRestrictions         DropInProductProgramRestriction[]
  memberMemberships                 MemberMembership[]
  billingStates                     MembershipBillingState[]
  billingRecords                    BillingRecord[]
  stripeSettings                    WorkspaceStripeSettings?
  stripeWebhookEvents               StripeWebhookEvent[]
  classTemplates                    ClassTemplate[]
  classInstances                    ClassInstance[]
  members                           Member[]
  guardians                         Guardian[]
  familyLinks                       FamilyLink[]
  classBookings                     ClassBooking[]
  waitlistEntries                   WaitlistEntry[]
  attendanceRecords                 AttendanceRecord[]
  invoices                          Invoice[]
  invoiceLineItems                  InvoiceLineItem[]
  payments                          Payment[]
  refunds                           Refund[]
  accountCredits                    AccountCredit[]
  creditRules                       CreditRule[]
  billingPolicies                   BillingPolicy[]
  paymentMethodReferences           PaymentMethodReference[]
  failedPaymentCases                FailedPaymentCase[]
  importJobs                        ImportJob[]
  importSourceFiles                 ImportSourceFile[]
  importFieldMappings               ImportFieldMapping[]
  stagingRecords                    StagingRecord[]
  validationIssues                  ValidationIssue[]
  reconciliationReports             ReconciliationReport[]
  migrationImportedRecords          MigrationImportedRecord[]
  progressModuleSetting             ProgressModuleSetting?
  beltDefinitions                   BeltDefinition[]
  memberProgressStates              MemberProgressState[]
  promotionRecords                  PromotionRecord[]
  conversationThreads               ConversationThread[]
  conversationParticipants          ConversationParticipant[]
  messages                          Message[]
  announcements                     Announcement[]
  notificationJobs                  NotificationJob[]
  emailTemplates                    EmailTemplate[]
  events                            Event[]
  eventBookings                     EventBooking[]
  privateLessonSlots                PrivateLessonSlot[]
  privateLessonBookings             PrivateLessonBooking[]
  formDocuments                     FormDocument[]
  formVersions                      FormVersion[]
  requiredFormAssignments           RequiredFormAssignment[]
  signatureRequests                 SignatureRequest[]
  signedDocuments                   SignedDocument[]
  workspaceUsers                    WorkspaceUser[]
  staffInvites                      StaffInvite[]
  settings                          WorkspaceSetting?
  createdAt                         DateTime                             @default(now())
  updatedAt                         DateTime                             @updatedAt

  @@map("workspaces")
}

model WorkspaceMigration {
  id                         String         @id @default(cuid())
  workspaceId                String         @unique
  stage                      MigrationStage @default(INTAKE_RECEIVED)
  currentSoftware            String?
  targetGoLiveDate           DateTime?      @db.Date
  memberCountEstimate        Int?
  billingStatus              String?
  scheduleComplexity         String?
  formsAndWaivers            String?
  dataScope                  String[]       @default([])
  accessInstructions         String?
  nextOwnerAction            String
  flowstateResponsibility    String
  expectedNextMilestone      String?
  expectedNextMilestoneAt    DateTime?
  goLiveScheduledFor         DateTime?      @db.Date
  operationallyReadyAt       DateTime?
  operationallyReadyByUserId String?
  workspace                  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  @@index([stage, updatedAt])
  @@map("workspace_migrations")
}

model Location {
  id           String    @id @default(cuid())
  workspaceId  String    @unique
  name         String
  timezone     String
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  countryCode  String?
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rooms        Room[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("locations")
}

model Room {
  id             String          @id @default(cuid())
  locationId     String
  name           String
  capacity       Int?
  isActive       Boolean         @default(true)
  archivedAt     DateTime?
  location       Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  classTemplates ClassTemplate[]
  classInstances ClassInstance[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([locationId, name])
  @@map("rooms")
}

model Program {
  id                           String                               @id @default(cuid())
  workspaceId                  String
  name                         String
  description                  String?
  ageGroupLabel                String?
  levelLabel                   String?
  progressTrackingEnabled      Boolean                              @default(false)
  archivedAt                   DateTime?
  workspace                    Workspace                            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  classTemplates               ClassTemplate[]
  classInstances               ClassInstance[]
  membershipPlanRestrictions   MembershipPlanProgramRestriction[]
  punchCardProductRestrictions PunchCardProductProgramRestriction[]
  dropInProductRestrictions    DropInProductProgramRestriction[]
  createdAt                    DateTime                             @default(now())
  updatedAt                    DateTime                             @updatedAt

  @@unique([workspaceId, name])
  @@map("programs")
}

model WorkspaceUser {
  id                       String              @id @default(cuid())
  workspaceId              String
  userId                   String              @unique
  role                     UserRole
  isActive                 Boolean             @default(true)
  workspace                Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachedClassTemplates    ClassTemplate[]
  coachedClassInstances    ClassInstance[]
  eventCoachAssignments    Event[]
  privateLessonSlots       PrivateLessonSlot[]
  coachedAttendanceRecords AttendanceRecord[]
  uploadedFormVersions     FormVersion[]       @relation("UploadedFormVersions")
  createdSignatureRequests SignatureRequest[]  @relation("SignatureRequestCreator")
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@unique([workspaceId, userId])
  @@map("workspace_users")
}

model ClassTemplate {
  id                        String             @id @default(cuid())
  workspaceId               String
  programId                 String
  roomId                    String
  coachWorkspaceUserId      String
  title                     String?
  weekday                   Weekday
  startTimeMinutes          Int
  endTimeMinutes            Int
  capacityOverride          Int?
  bookingCutoffMinutes      Int
  cancellationCutoffMinutes Int
  archivedAt                DateTime?
  workspace                 Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  program                   Program            @relation(fields: [programId], references: [id])
  room                      Room               @relation(fields: [roomId], references: [id])
  coachWorkspaceUser        WorkspaceUser      @relation(fields: [coachWorkspaceUserId], references: [id])
  classInstances            ClassInstance[]
  classBookings             ClassBooking[]
  waitlistEntries           WaitlistEntry[]
  attendanceRecords         AttendanceRecord[]
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, weekday])
  @@index([coachWorkspaceUserId])
  @@index([roomId])
  @@index([programId])
  @@map("class_templates")
}

model Member {
  id                       String                    @id @default(cuid())
  workspaceId              String
  userId                   String?                   @unique
  fullName                 String
  email                    String?                   @db.Citext
  phone                    String?
  dateOfBirth              DateTime?                 @db.Date
  status                   MemberStatus              @default(TRIAL)
  notes                    String?
  tags                     String[]                  @default([])
  workspace                Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                     User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  familyLinks              FamilyLink[]              @relation("ChildMemberFamilyLinks")
  punchCards               MemberPunchCard[]
  memberships              MemberMembership[]
  billingStates            MembershipBillingState[]
  billingRecords           BillingRecord[]
  invoices                 Invoice[]
  payments                 Payment[]
  refunds                  Refund[]
  accountCredits           AccountCredit[]
  failedPaymentCases       FailedPaymentCase[]
  progressState            MemberProgressState?
  promotionRecords         PromotionRecord[]
  conversationParticipants ConversationParticipant[]
  messages                 Message[]
  eventBookings            EventBooking[]
  privateLessonBookings    PrivateLessonBooking[]
  classBookings            ClassBooking[]
  waitlistEntries          WaitlistEntry[]
  attendanceRecords        AttendanceRecord[]
  signatureRequests        SignatureRequest[]
  signedDocuments          SignedDocument[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([workspaceId, status])
  @@index([workspaceId, fullName])
  @@index([workspaceId, email])
  @@index([workspaceId, userId])
  @@map("members")
}

model Guardian {
  id                       String                    @id @default(cuid())
  workspaceId              String
  fullName                 String
  email                    String?                   @db.Citext
  phone                    String?
  notes                    String?
  workspace                Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  familyLinks              FamilyLink[]
  classBookings            ClassBooking[]
  conversationParticipants ConversationParticipant[]
  messages                 Message[]
  signatureRequests        SignatureRequest[]
  signedDocuments          SignedDocument[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([workspaceId, fullName])
  @@index([workspaceId, email])
  @@map("guardians")
}

model FamilyLink {
  id                String    @id @default(cuid())
  workspaceId       String
  guardianId        String
  childMemberId     String
  relationshipLabel String?
  isPrimary         Boolean   @default(false)
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  guardian          Guardian  @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  childMember       Member    @relation("ChildMemberFamilyLinks", fields: [childMemberId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([guardianId, childMemberId])
  @@index([workspaceId, childMemberId])
  @@index([workspaceId, guardianId])
  @@map("family_links")
}

model ClassBooking {
  id                      String             @id @default(cuid())
  workspaceId             String
  memberId                String
  guardianId              String?
  classTemplateId         String
  classInstanceId         String?
  memberPunchCardId       String?
  dropInProductId         String?
  scheduledForDate        DateTime           @db.Date
  bookingType             ClassBookingType   @default(MEMBERSHIP)
  status                  ClassBookingStatus @default(BOOKED)
  source                  ClassBookingSource @default(ADMIN)
  consumedPunchCount      Int                @default(0)
  dropInPriceCents        Int?
  dropInCurrency          String?
  dropInCheckoutSessionId String?
  dropInPaymentIntentId   String?
  dropInPaidAt            DateTime?
  pendingPaymentExpiresAt DateTime?
  workspace               Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member                  Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  guardian                Guardian?          @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  classTemplate           ClassTemplate      @relation(fields: [classTemplateId], references: [id], onDelete: Restrict)
  classInstance           ClassInstance?     @relation(fields: [classInstanceId], references: [id], onDelete: SetNull)
  memberPunchCard         MemberPunchCard?   @relation(fields: [memberPunchCardId], references: [id], onDelete: SetNull)
  dropInProduct           DropInProduct?     @relation(fields: [dropInProductId], references: [id], onDelete: SetNull)
  promotedWaitlistEntries WaitlistEntry[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@unique([workspaceId, memberId, classTemplateId, scheduledForDate], map: "class_bookings_member_template_date_key")
  @@index([workspaceId, scheduledForDate])
  @@index([workspaceId, classTemplateId, scheduledForDate])
  @@index([workspaceId, classInstanceId])
  @@index([workspaceId, memberId])
  @@index([workspaceId, status, pendingPaymentExpiresAt])
  @@index([workspaceId, memberPunchCardId])
  @@index([workspaceId, dropInProductId])
  @@map("class_bookings")
}

model AttendanceRecord {
  id                   String          @id @default(cuid())
  workspaceId          String
  memberId             String
  classTemplateId      String
  classInstanceId      String?
  scheduledForDate     DateTime        @db.Date
  state                AttendanceState
  coachWorkspaceUserId String?
  note                 String?
  workspace            Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member               Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  classTemplate        ClassTemplate   @relation(fields: [classTemplateId], references: [id], onDelete: Restrict)
  classInstance        ClassInstance?  @relation(fields: [classInstanceId], references: [id], onDelete: SetNull)
  coachWorkspaceUser   WorkspaceUser?  @relation(fields: [coachWorkspaceUserId], references: [id], onDelete: SetNull)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@unique([workspaceId, memberId, classTemplateId, scheduledForDate], map: "attendance_records_member_template_date_key")
  @@index([workspaceId, classTemplateId, scheduledForDate], map: "attendance_records_workspaceId_classTemplateId_scheduledFor_idx")
  @@index([workspaceId, classInstanceId])
  @@index([workspaceId, memberId])
  @@index([coachWorkspaceUserId])
  @@map("attendance_records")
}

model ClassInstance {
  id                        String              @id @default(cuid())
  workspaceId               String
  classTemplateId           String
  programId                 String
  roomId                    String
  coachWorkspaceUserId      String
  scheduledForDate          DateTime            @db.Date
  title                     String?
  startTimeMinutes          Int
  endTimeMinutes            Int
  capacityOverride          Int?
  bookingCutoffMinutes      Int
  cancellationCutoffMinutes Int
  status                    ClassInstanceStatus @default(ACTIVE)
  cancellationReason        String?
  rescheduledFromDate       DateTime?           @db.Date
  source                    BillingSource       @default(CURRENT)
  workspace                 Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  classTemplate             ClassTemplate       @relation(fields: [classTemplateId], references: [id], onDelete: Restrict)
  program                   Program             @relation(fields: [programId], references: [id])
  room                      Room                @relation(fields: [roomId], references: [id])
  coachWorkspaceUser        WorkspaceUser       @relation(fields: [coachWorkspaceUserId], references: [id])
  classBookings             ClassBooking[]
  waitlistEntries           WaitlistEntry[]
  attendanceRecords         AttendanceRecord[]
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  @@unique([workspaceId, classTemplateId, scheduledForDate], map: "class_instances_template_date_key")
  @@index([workspaceId, scheduledForDate, status])
  @@index([workspaceId, coachWorkspaceUserId, scheduledForDate])
  @@index([workspaceId, programId])
  @@index([workspaceId, roomId])
  @@map("class_instances")
}

model MembershipPlan {
  id                          String                             @id @default(cuid())
  workspaceId                 String
  name                        String
  description                 String?
  monthlyPriceCents           Int
  currency                    String                             @default("usd")
  cancellationPolicyReference String?
  freezePolicyReference       String?
  stripeProductId             String?
  stripePriceId               String?
  archivedAt                  DateTime?
  workspace                   Workspace                          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  programRestrictions         MembershipPlanProgramRestriction[]
  memberMemberships           MemberMembership[]
  createdAt                   DateTime                           @default(now())
  updatedAt                   DateTime                           @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId, archivedAt])
  @@map("membership_plans")
}

model MembershipPlanProgramRestriction {
  id               String         @id @default(cuid())
  workspaceId      String
  membershipPlanId String
  programId        String
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  membershipPlan   MembershipPlan @relation(fields: [membershipPlanId], references: [id], onDelete: Cascade)
  program          Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([membershipPlanId, programId], map: "membership_plan_program_restrictions_plan_program_key")
  @@index([workspaceId, membershipPlanId], map: "membership_plan_program_restrictions_workspaceId_membership_idx")
  @@index([workspaceId, programId])
  @@map("membership_plan_program_restrictions")
}

model PunchCardProduct {
  id                  String                               @id @default(cuid())
  workspaceId         String
  name                String
  description         String?
  punchesIncluded     Int
  priceCents          Int
  currency            String                               @default("usd")
  isEnabled           Boolean                              @default(true)
  archivedAt          DateTime?
  restrictionMode     AccessRestrictionMode                @default(GENERAL)
  stripeProductId     String?
  stripePriceId       String?
  workspace           Workspace                            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  programRestrictions PunchCardProductProgramRestriction[]
  memberPunchCards    MemberPunchCard[]
  createdAt           DateTime                             @default(now())
  updatedAt           DateTime                             @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, isEnabled, archivedAt])
  @@map("punch_card_products")
}

model PunchCardProductProgramRestriction {
  id                 String           @id @default(cuid())
  workspaceId        String
  punchCardProductId String
  programId          String
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  punchCardProduct   PunchCardProduct @relation(fields: [punchCardProductId], references: [id], onDelete: Cascade)
  program            Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([punchCardProductId, programId], map: "punch_card_product_program_restrictions_product_program_key")
  @@index([workspaceId, punchCardProductId], map: "punch_card_product_program_restrictions_workspaceId_punchCa_idx")
  @@index([workspaceId, programId], map: "punch_card_product_program_restrictions_workspaceId_program_idx")
  @@map("punch_card_product_program_restrictions")
}

model MemberPunchCard {
  id                      String                @id @default(cuid())
  workspaceId             String
  memberId                String
  punchCardProductId      String
  originalPunches         Int
  remainingPunches        Int
  status                  MemberPunchCardStatus @default(ACTIVE)
  purchasePriceCents      Int
  purchaseCurrency        String                @default("usd")
