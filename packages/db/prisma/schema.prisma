// Processor dispute state is separate from the successful collection/refund ledgers.
model PaymentDispute {
  id                      String                     @id @default(uuid())
  workspaceId             String
  providerAccountId       String
  livemode                Boolean
  providerDisputeId       String
  chargeId                String
  paymentIntentId         String?
  paymentId               String?
  providerStatus          String
  reason                  String
  amountCents             Int
  currency                String
  chargeAmountCents       Int
  chargeRefundedCents     Int                        @default(0)
  isChargeRefundable      Boolean
  evidenceDueAt           DateTime?
  evidence                Json
  evidenceHash            String
  version                 Int                        @default(1)
  reviewerWorkspaceUserId String?
  pendingTreatment        String                     @default("KEEP_RESERVATIONS")
  accessState             String
  moneyState              String
  lastVerifiedAt          DateTime?
  lastError               String?
  resolvedAt              DateTime?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  workspace               Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payment                 Payment?                   @relation(fields: [workspaceId, paymentId], references: [workspaceId, id], onDelete: Restrict)
  reviewer                WorkspaceUser?             @relation(fields: [workspaceId, reviewerWorkspaceUserId], references: [workspaceId, id], onDelete: Restrict)
  allocations             PaymentDisputeAllocation[]
  events                  PaymentDisputeEvent[]
  holds                   FinancialEntitlementHold[]
  reviewCases             FinancialReviewCase[]

  @@unique([workspaceId, id])
  @@unique([providerAccountId, livemode, providerDisputeId])
  @@index([workspaceId, resolvedAt, createdAt])
  @@index([workspaceId, paymentIntentId])
  @@map("payment_disputes")
}

model PaymentDisputeAllocation {
  id                   String         @id @default(uuid())
  workspaceId          String
  disputeId            String
  paymentId            String
  providerAllocationId String?
  fundedAmountCents    Int
  createdAt            DateTime       @default(now())
  workspace            Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dispute              PaymentDispute @relation(fields: [workspaceId, disputeId], references: [workspaceId, id], onDelete: Cascade)
  payment              Payment        @relation(fields: [workspaceId, paymentId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([disputeId, paymentId])
  @@index([workspaceId, paymentId])
  @@map("payment_dispute_allocations")
}

model PaymentDisputeEvent {
  id          String         @id @default(uuid())
  workspaceId String
  disputeId   String
  requestKey  String
  payloadHash String
  kind        String
  actorUserId String?
  before      Json
  after       Json
  reason      String?
  createdAt   DateTime       @default(now())
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dispute     PaymentDispute @relation(fields: [workspaceId, disputeId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([disputeId, requestKey])
  @@index([workspaceId, createdAt])
  @@map("payment_dispute_events")
}

// New-business setup is separate from source-system migration. Account IDs are
// opaque receipts; global authentication identities are not tenant-owned data.
model WorkspaceSetup {
  id                      String    @id @default(cuid())
  workspaceId             String    @unique
  ownerUserId             String
  serviceMode             String
  version                 Int       @default(0)
  verificationHash        String?   @unique
  verificationEmailHash   String?
  verificationRequestedAt DateTime?
  verificationExpiresAt   DateTime?
  ownerVerifiedAt         DateTime?
  verifiedEmailHash       String?
  workspace               Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([ownerUserId])
  @@map("workspace_setup")
}

model WorkspaceSetupActivation {
  id                String    @id @default(cuid())
  workspaceId       String    @unique
  setupId           String
  ownerUserId       String
  setupVersion      Int
  serviceMode       String
  verifiedEmailHash String
  ownerVerifiedAt   DateTime
  snapshotHash      String
  snapshot          Json
  acceptedAt        DateTime
  activatedAt       DateTime  @default(now())
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_setup_activations")
}

// Global, ephemeral abuse counters. No account/workspace relationship or raw identifier.
model PublicAuthThrottleBucket {
  keyHash      String   @id
  attempts     Int      @default(1)
  windowEndsAt DateTime
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expiresAt])
  @@map("public_auth_throttle_buckets")
}

// Immutable owner-confirmed rules for new class claims. Existing commitments retain their snapshots.
model WorkspaceSchedulingPolicyRevision {
  id                 String    @id @default(cuid())
  workspaceId        String
  version            Int
  policy             Json
  policyHash         String
  previousPolicyHash String?
  actorUserId        String
  reason             String
  previewHash        String
  activatedAt        DateTime
  createdAt          DateTime  @default(now())
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, version])
  @@index([workspaceId, activatedAt, version], map: "scheduling_policy_workspace_activated_version_idx")
  @@map("workspace_scheduling_policy_revisions")
}

