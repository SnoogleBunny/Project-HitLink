{
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "paths": {
      "@flowstate/db": ["../../packages/db/src/index.ts"],
      "@flowstate/auth": ["../../packages/auth/src/index.ts"]
    },
    "typeRoots": ["../../apps/admin-web/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["../../playwright.config.ts", "./**/*.ts"]
}
