{
  "name": "hitlink-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @hitlink/db db:generate",
    "db:migrate": "pnpm --filter @hitlink/db db:migrate",
    "db:migrate:deploy": "pnpm --filter @hitlink/db db:migrate:deploy",
    "db:validate": "pnpm --filter @hitlink/db db:validate",
    "db:studio": "pnpm --filter @hitlink/db db:studio"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["sharp"]
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.3",
    "typescript": "5.9.2"
  }
}
