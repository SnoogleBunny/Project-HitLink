{
  "name": "flowstate-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.23.4",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "dev": "dotenv -e .env -- turbo run dev",
    "build": "dotenv -e .env -- turbo run build",
    "lint": "turbo run lint",
    "check-types": "corepack pnpm db:generate && turbo run check-types && corepack pnpm exec tsc --noEmit -p tests/e2e/tsconfig.json",
    "test": "turbo run test --concurrency=1 && corepack pnpm test:tooling",
    "test:tooling": "node --test tests/tooling/windows-bootstrap.test.mjs tests/e2e/canonical-playwright.test.mjs tests/tooling/turbo-environment.test.mjs",
    "test:integration": "node -e \"if (!process.env.TEST_DATABASE_URL) { console.error('TEST_DATABASE_URL is required for database integration tests.'); process.exit(1); }\" && corepack pnpm --filter admin-web exec vitest run integration.test.ts && corepack pnpm --filter member-web exec vitest run integration.test.ts && corepack pnpm --filter @flowstate/auth exec vitest run integration.test.ts",
    "test:migration:integration": "corepack pnpm --filter admin-web test:migration:integration",
    "test:e2e:onboarding": "playwright test tests/e2e/migration-first-onboarding.spec.ts --project=chromium",
    "test:e2e": "corepack pnpm db:reset:demo && playwright test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "corepack pnpm --filter @flowstate/db db:generate",
    "db:migrate": "corepack pnpm --filter @flowstate/db db:migrate",
    "db:migrate:deploy": "corepack pnpm --filter @flowstate/db db:migrate:deploy",
    "db:reset:demo": "corepack pnpm --filter @flowstate/db db:reset:demo",
    "db:seed": "corepack pnpm --filter @flowstate/db db:seed",
    "db:validate": "corepack pnpm --filter @flowstate/db db:validate",
    "db:studio": "pnpm --filter @flowstate/db db:studio",
    "test:e2e:preflight": "node tests/e2e/canonical-playwright.mjs --preflight"
  },
  "pnpm": {
    "overrides": {
      "next@16.2.12>postcss": "8.5.23",
      "next@16.2.12>sharp": "0.35.3"
    },
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@prisma/client": "^6.18.0",
    "dotenv-cli": "10.0.0",
    "prettier": "^3.7.4",
    "turbo": "^2.9.3",
    "typescript": "5.9.2",
    "vitest": "^3.2.4"
  }
}
