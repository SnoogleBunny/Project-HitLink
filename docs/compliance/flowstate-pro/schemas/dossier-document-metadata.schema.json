{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flowstate-pro/dossier-document-metadata.schema.json",
  "title": "Flowstate Pro dossier manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "documents"],
  "properties": {
    "schema_version": { "const": 1 },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/document" }
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "DRAFT",
        "PROPOSED",
        "COUNSEL_REVIEW_REQUIRED",
        "OWNER_APPROVAL_REQUIRED",
        "APPROVED",
        "SPECIFIED",
        "IMPLEMENTED",
        "TECHNICALLY_VERIFIED",
        "OPERATIONALLY_EXERCISED",
        "EVIDENCE_COMPLETE",
        "LEGALLY_REVIEWED",
        "APPROVED_FOR_PROFILE",
        "BLOCKED",
        "NOT_APPLICABLE",
        "SUPERSEDED"
      ]
    },
    "accountableFunction": {
      "enum": [
        "Architecture/Backend",
        "Database",
        "Legal/Privacy",
        "Legal/counsel",
        "Operations",
        "Operations/QA-Assurance",
        "Product",
        "QA/Assurance",
        "Security/Privacy"
      ]
    },
    "profile": {
      "type": "string",
      "pattern": "^(ALL|VIRGINIA|BC_PRIVATE_CLINIC|[A-Z][A-Z0-9._-]{2,63})$"
    },
    "nonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "nonEmptySortedUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "reference": {
      "type": "string",
      "maxLength": 256,
      "anyOf": [
        {
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\u0000)(?=.{1,256}$)[^\\s]+/[^\\s]+$"
        },
        { "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{1,255}$" }
      ]
    },
    "referenceArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reference" }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "path",
        "title",
        "status",
        "owner",
        "source",
        "affected_profiles",
        "effective_date",
        "required_review",
        "evidence_references",
        "latest_change_id"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9._-]{2,63}$"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\u0000)(?:docs/compliance/flowstate-pro/.+\\.md|docs/plans/2026-08-10-hipaa-canada-compliance-implementation-plan\\.md)$"
        },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "$ref": "#/$defs/status" },
        "owner": { "$ref": "#/$defs/accountableFunction" },
        "source": { "$ref": "#/$defs/referenceArray" },
        "affected_profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/profile" }
        },
        "effective_date": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "required_review": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/accountableFunction" }
        },
        "evidence_references": { "$ref": "#/$defs/referenceArray" },
        "latest_change_id": {
          "type": "string",
          "pattern": "^WP[0-9]+\\.[0-9]+-CC-[0-9]{3}$"
        }
      }
    }
  },
  "x-ordering": {
    "documents": "path-ascending",
    "array_fields": "lexicographic-ascending-unique"
  }
}
